{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yiki-online",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ALLOWED_LINE_GROUP_NAME": "Yiki-online"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yiki-results",
      "database_id": "d4747338-05a9-4909-bed9-98fbb5db98ea",
      "migrations_dir": "migrations"
    }
  ]
}
